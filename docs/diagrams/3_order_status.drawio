<mxfile host="app.diagrams.net" agent="PRM393 Moc Cafe">
  <diagram id="order-status" name="3. Order status">
    <mxGraphModel dx="1200" dy="500" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="360" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s-title" value="Only a Pending order can be cancelled; the owner moves it forward" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="24" y="8" width="900" height="32" as="geometry" />
        </mxCell>
        <mxCell id="s-start" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="32" y="100" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="s-pending" value="&lt;b&gt;Pending&lt;/b&gt;&lt;br&gt;Chờ xác nhận" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="82" width="130" height="56" as="geometry" />
        </mxCell>
        <mxCell id="s-confirmed" value="&lt;b&gt;Confirmed&lt;/b&gt;&lt;br&gt;Đã xác nhận" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="82" width="130" height="56" as="geometry" />
        </mxCell>
        <mxCell id="s-preparing" value="&lt;b&gt;Preparing&lt;/b&gt;&lt;br&gt;Đang pha chế" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="82" width="130" height="56" as="geometry" />
        </mxCell>
        <mxCell id="s-delivering" value="&lt;b&gt;Delivering&lt;/b&gt;&lt;br&gt;Đang giao" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="790" y="82" width="130" height="56" as="geometry" />
        </mxCell>
        <mxCell id="s-completed" value="&lt;b&gt;Completed&lt;/b&gt;&lt;br&gt;Hoàn thành" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1020" y="82" width="130" height="56" as="geometry" />
        </mxCell>
        <mxCell id="s-cancelled" value="&lt;b&gt;Cancelled&lt;/b&gt;&lt;br&gt;Đã hủy" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="248" width="130" height="56" as="geometry" />
        </mxCell>
        <mxCell id="t-start" value="place order" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1" source="s-start" target="s-pending">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t-confirm" value="owner confirms" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1" source="s-pending" target="s-confirmed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t-prepare" value="owner starts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1" source="s-confirmed" target="s-preparing">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t-deliver" value="owner ships" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1" source="s-preparing" target="s-delivering">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t-complete" value="owner completes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1" source="s-delivering" target="s-completed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t-cancel" value="customer or owner&lt;br&gt;(only while Pending)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B85450;fontColor=#B85450;fontSize=11;labelBackgroundColor=#FFFFFF;align=left;spacingLeft=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s-pending" target="s-cancelled">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s-note" value="Each forward step is saved to SQLite and sends the customer a notification (OrderProvider.updateStatus)." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="330" y="260" width="700" height="32" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>